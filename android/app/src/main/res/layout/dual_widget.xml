   <ProgressBar android:id="@+id/bar2" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:max="100" android:progress="50" android:progressDrawable="@drawable/w_progress"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/bminus2" android:layout_width="48dp" android:layout_height="match_parent" android:gravity="center" android:text="−" android:textSize="22sp" android:textColor="@color/w_on_primary" android:contentDescription="İkinci ışık parlaklık azalt"/>
    <TextView android:id="@+id/level2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="—" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/w_text"/>
    <TextView android:id="@+id/bplus2" android:layout_width="48dp" android:layout_height="match_parent" android:gravity="center" android:text="+" android:textSize="22sp" android:textColor="@color/w_text" android:contentDescription="İkinci ışık parlaklık artır"/>
   </LinearLayout>
  </FrameLayout>
  <TextView android:layout_width="1dp" android:layout_height="8dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
   <TextView android:id="@+id/warm2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/w_tonal_left" android:text="Sıcak" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/w_on_tonal"/>
   <TextView android:layout_width="2dp" android:layout_height="1dp"/>
   <TextView android:id="@+id/neutral2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/w_tonal_mid" android:text="Nötr" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/w_on_tonal"/>
   <TextView android:layout_width="2dp" android:layout_height="1dp"/>
   <TextView android:id="@+id/cool2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/w_tonal_right" android:text="Soğuk" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/w_on_tonal"/>
  </LinearLayout>
 </LinearLayout>
</LinearLayout>
