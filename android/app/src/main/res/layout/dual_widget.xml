<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/w_surface">
 <LinearLayout android:id="@+id/light1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:gravity="center_vertical">
   <TextView android:id="@+id/name1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="Işık seçin" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/w_text" android:maxLines="1" android:ellipsize="end"/>
   <ImageView android:id="@+id/sw1" android:layout_width="44dp" android:layout_height="26dp" android:src="@drawable/w_switch_off" android:contentDescription="Birinci ışığı aç veya kapat"/>
  </LinearLayout>
  <TextView android:layout_width="1dp" android:layout_height="8dp"/>
  <FrameLayout android:layout_width="match_parent" android:layout_height="48dp">
   <ProgressBar android:id="@+id/bar1" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:max="100" android:progress="50" android:progressDrawable="@drawable/w_progress"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/bminus1" android:layout_width="48dp" android:layout_height="match_parent" android:gravity="center" android:text="−" android:textSize="22sp" android:textColor="@color/w_on_primary" android:contentDescription="Birinci ışık parlaklık azalt"/>
    <TextView android:id="@+id/level1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="—" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/w_text"/>
    <TextView android:id="@+id/bplus1" android:layout_width="48dp" android:layout_height="match_parent" android:gravity="center" android:text="+" android:textSize="22sp" android:textColor="@color/w_text" android:contentDescription="Birinci ışık parlaklık artır"/>
   </LinearLayout>
  </FrameLayout>
  <TextView android:layout_width="1dp" android:layout_height="8dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
   <TextView android:id="@+id/warm1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/w_tonal_left" android:text="Sıcak" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/w_on_tonal"/>
   <TextView android:layout_width="2dp" android:layout_height="1dp"/>
   <TextView android:id="@+id/neutral1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/w_tonal_mid" android:text="Nötr" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/w_on_tonal"/>
   <TextView android:layout_width="2dp" android:layout_height="1dp"/>
   <TextView android:id="@+id/cool1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/w_tonal_right" android:text="Soğuk" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/w_on_tonal"/>
  </LinearLayout>
 </LinearLayout>
 <TextView android:layout_width="12dp" android:layout_height="1dp"/>
 <LinearLayout android:id="@+id/light2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
