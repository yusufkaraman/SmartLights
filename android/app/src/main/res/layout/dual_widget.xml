   <TextView android:id="@+id/name2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="İkinci ışık" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/w_text" android:maxLines="1" android:ellipsize="end"/>
